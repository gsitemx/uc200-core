{
  "name": "uc200/core",
  "description": "Base MVC en PHP 8.2 para UC200 Core.",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/Helpers/functions.php"
    ]
  },
  "scripts": {
    "serve": "php -S 127.0.0.1:8080 -t public"
  },
  "config": {
    "sort-packages": true
  }
}
